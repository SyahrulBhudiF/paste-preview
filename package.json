{
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"start": "vp dev --host 0.0.0.0",
		"alchemy:login": "vp exec alchemy login alchemy/alchemy.run.ts --configure",
		"deploy": "vp exec alchemy deploy --stage dev_runner alchemy/alchemy.run.ts",
		"deploy:ci": "vp exec alchemy deploy --yes --stage dev_runner alchemy/alchemy.run.ts",
		"destroy": "vp exec alchemy destroy alchemy/alchemy.run.ts",
		"infra:dev": "vp exec alchemy dev alchemy/alchemy.run.ts",
		"cf-typegen": "vp exec wrangler types",
		"lint": "vp exec oxlint -c .oxlintrc.json",
		"lint:fix": "vp exec oxlint -c .oxlintrc.json --fix",
		"format": "vp exec oxfmt -c .oxfmtrc.json . --write",
		"format:check": "vp exec oxfmt -c .oxfmtrc.json . --check",
		"check": "vp run format:check && vp run lint",
		"test": "vitest --config vitest.config.ts",
		"test:run": "vitest run --config vitest.config.ts",
		"prepare": "husky",
		"doctor": "react-doctor"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cloudflare/vite-plugin": "1.64.0",
		"@effect/platform-node": "4.0.5",
		"@radix-ui/react-slot": "latest",
		"@tailwindcss/vite": "latest",
		"@tanstack/highlight": "^1.1.0",
		"@tanstack/markdown": "^1.0.0",
		"@tanstack/react-form": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "latest",
		"@vitejs/plugin-react": "latest",
		"alchemy": "2.0.0-beta.83",
		"clsx": "latest",
		"dompurify": "latest",
		"effect": "4.0.5",
		"github-markdown-css": "^5.9.0",
		"lucide-react": "latest",
		"nanoid": "latest",
		"react": "latest",
		"react-dom": "latest",
		"shiki": "^4.5.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest",
		"typescript": "latest",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"wrangler": "latest"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.5",
		"@oxlint/plugins": "1.89.0",
		"@types/node": "^26.6.5",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"husky": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"react-doctor": "^0.9.18",
		"vite-plus": "^1.3.0",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@11.9.0"
}
